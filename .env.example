# ---------------------------------------------------------------------------
# Evmetrik website - environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# values in your hosting provider's environment settings for production.
#
# Nothing below is prefixed with NEXT_PUBLIC_ on purpose. NEXT_PUBLIC_* values
# are inlined into the JavaScript bundle that every visitor downloads, which
# would publish the pilot mailbox address on the website. Keep these server-side.
# ---------------------------------------------------------------------------

# The ONE and ONLY recipient for pilot-request submissions.
# Every form submission is delivered to this address and nowhere else:
# no cc, no bcc, no auto-reply to the visitor, no copy anywhere else.
# The address is never displayed on any page of the site.
CONTACT_TO_EMAIL=

# Outgoing mail server (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender address used on the notification email. It must be an address your
# mail provider allows you to send from.
MAIL_FROM="Evmetrik Website <no-reply@evmetrik.com>"
